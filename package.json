{
  "name": "ytdownloader",
  "version": "0.1.0",
  "private": true,
  "bin": "app.js",
  "main": "app.js",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/download-binaries.js && (python3 -m pip install -r python/requirements.txt || echo 'Pip install ignored') && next build",
    "build-exe": "npm run build && npx pkg . --targets win-x64 --output dist/ytdownloader.exe --compress Brotli",
    "start": "node server.js",
    "lint": "eslint",
    "postinstall": "node scripts/download-binaries.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "ffmpeg-static": "^5.2.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "play-dl": "^1.9.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "youtube-dl-exec": "^3.1.6",
    "youtube-ext": "^1.1.25",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pkg": {
    "targets": [
      "win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      ".next/**/*"
    ],
    "assets": [
      ".next/**/*",
      "public/**/*",
      "python/**/*"
    ]
  }
}
